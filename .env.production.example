# ============================================================================
# AsistControl — Variables de Entorno para Producción (.env.production)
# ============================================================================
# Copia este archivo a .env.production y define valores reales y seguros.
# Genera secretos con: openssl rand -base64 32
# ============================================================================

# ── Base de Datos (PostgreSQL 16) ───────────────────────────────────────────
POSTGRES_DB=asistencias
POSTGRES_USER=asistcontrol_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_AQUI
DATABASE_URL="postgresql://asistcontrol_admin:CAMBIAR_POR_PASSWORD_SEGURO_AQUI@postgres:5432/asistencias?schema=public&connection_limit=20&pool_timeout=10"

# ── Redis (Cache, Rate Limiting & Queue) ────────────────────────────────────
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_REDIS_SEGURO
REDIS_URL="redis://:CAMBIAR_POR_PASSWORD_REDIS_SEGURO@redis:6379/0"

# ── Autenticación & Seguridad (NextAuth.js v5) ──────────────────────────────
# URL pública de tu dominio con HTTPS
NEXTAUTH_URL="https://asistcontrol.tu-empresa.com"
# Secreto para sesiones y JWT: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIAR_POR_SECRETO_ALEATORIO_32_BYTES"

# Secreto para firma digital HMAC-SHA256 de códigos QR
QR_HMAC_SECRET="CAMBIAR_POR_SECRETO_QR_ALEATORIO_32_BYTES"
CRON_SECRET="CAMBIAR_POR_SECRETO_CRON_ALEATORIO_32_BYTES"
JWT_SECRET="CAMBIAR_POR_SECRETO_JWT_ALEATORIO_32_BYTES"
JWT_EXPIRES_IN="7d"

# ── Web Push API (Notificaciones Push VAPID) ────────────────────────────────
# Generar par de llaves VAPID con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="CAMBIAR_POR_TU_VAPID_PUBLIC_KEY"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="CAMBIAR_POR_TU_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="CAMBIAR_POR_TU_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:soporte@asistcontrol.com"

# ── Observabilidad & Monitoreo de Errores (Sentry) ──────────────────────────
# DSN opcional de tu proyecto Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"

# ── Parámetros del Entorno ──────────────────────────────────────────────────
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
