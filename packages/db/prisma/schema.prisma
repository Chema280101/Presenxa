// This is your Prisma schema file
// Learn more at https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// ─────────────────────────────────────────────────────────────
//  ORGANIZACIÓN
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  type      OrgType
  slug      String   @unique
  logoUrl   String?
  // Configuración JSON de la organización. Estructura esperada:
  // {
  //   "timezone": "America/Lima"   ← Zona horaria para reportes y logs
  // }
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations       Location[]
  users           User[]
  schedules       Schedule[]
  auditLogs       AuditLog[]
  departments     Department[]
  timeOffRequests TimeOffRequest[]
  holidays        Holiday[]

  @@map("organizations")
}

enum OrgType {
  EMPRESA
}

// ─────────────────────────────────────────────────────────────
//  DEPARTAMENTOS / ÁREAS
// ─────────────────────────────────────────────────────────────

model Department {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // Ej: "Housekeeping", "Cocina Caliente", "Front Desk"
  
  users          User[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("departments")
}

// ─────────────────────────────────────────────────────────────
//  FERIADOS Y DÍAS NO LABORABLES
// ─────────────────────────────────────────────────────────────

model Holiday {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String       // Ej: "Navidad", "Día de la Independencia"
  date           DateTime     @db.Date
  
  // Opcional: Si aplica solo a una sede específica
  locationId     String?      @db.Uuid
  
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, date, locationId])
  @@index([organizationId, date])
  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────
//  SEDE / UBICACIÓN
// ─────────────────────────────────────────────────────────────

model Location {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  timezone       String       @default("America/Lima")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kiosks      Kiosk[]
  users       User[]       @relation("UserLocation")
  attendances Attendance[]
  schedules   Schedule[]

  @@map("locations")
}

// ─────────────────────────────────────────────────────────────
//  USUARIOS
// ─────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?      @db.Uuid
  location       Location?    @relation("UserLocation", fields: [locationId], references: [id])
  departmentId   String?      @db.Uuid
  department     Department?  @relation(fields: [departmentId], references: [id])

  firstName  String
  lastName   String
  email      String    @unique
  phone      String?
  photoUrl   String?
  documentId String? // DNI, carnet estudiantil, etc.
  birthDate  DateTime? // Fecha de nacimiento para celebraciones de cumpleaños y recordatorios

  role UserRole @default(EMPLEADO)

  // ── Núcleo QR y NFC ─────────────────────────────────────────
  qrToken         String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrGeneratedAt   DateTime  @default(now())
  qrInvalidatedAt DateTime? // Revocar QR sin borrar usuario
  nfcCardUid      String?   @unique // UID de la tarjeta o llavero NFC físico

  // ── Acceso al sistema ──────────────────────────────────────
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances       Attendance[]
  userSchedules     UserSchedule[]
  shiftOverrides    ShiftOverride[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  timeOffRequests   TimeOffRequest[]

  @@index([qrToken])
  @@index([nfcCardUid])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  EMPLEADO
}

enum PunchMethod {
  QR
  NFC
  PIN
  MANUAL
  BIOMETRICO
}

// ─────────────────────────────────────────────────────────────
//  HORARIOS Y TURNOS
// ─────────────────────────────────────────────────────────────

model Schedule {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?      @db.Uuid
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name           String

  // Días laborales (bitmask): Lu=1, Ma=2, Mi=4, Ju=8, Vi=16, Sa=32, Do=64
  workdaysMask Int @default(31) // Lun-Vie por defecto

  // Horario esperado Tramo 1 (se guarda como hora del día, ej: 08:00)
  entryHour   Int @default(8)
  entryMinute Int @default(0)
  exitHour    Int @default(17)
  exitMinute  Int @default(0)

  toleranceMinutes Int @default(5) // Minutos de tolerancia para tarde en tramo 1

  // Soporte para Jornada Partida / Doble Turno (ej. Mañana 08:00-13:00 y Tarde 15:00-19:00)
  isSplit           Boolean @default(false)
  entryHour2        Int?
  entryMinute2      Int?
  exitHour2         Int?
  exitMinute2       Int?
  toleranceMinutes2 Int?    @default(5)

  isTemplate Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSchedules  UserSchedule[]
  shiftOverrides ShiftOverride[]

  @@map("schedules")
}

model UserSchedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId String   @db.Uuid
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  @@map("user_schedules")
}

model ShiftOverride {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  scheduleId String?   @db.Uuid
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  date       DateTime  @db.Date
  
  isDayOff   Boolean   @default(false)

  createdAt  DateTime  @default(now())

  @@unique([userId, date])
  @@map("shift_overrides")
}

// ─────────────────────────────────────────────────────────────
//  DISPOSITIVOS KIOSK
// ─────────────────────────────────────────────────────────────

model Kiosk {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String

  apiKey     String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  ipAddress  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]

  @@map("kiosks")
}

// ─────────────────────────────────────────────────────────────
//  ASISTENCIAS — TABLA CENTRAL
// ─────────────────────────────────────────────────────────────

model Attendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id])
  kioskId    String?  @db.Uuid
  kiosk      Kiosk?   @relation(fields: [kioskId], references: [id])

  date DateTime @db.Date // Fecha sin hora

  // Marcaciones físicas Tramo 1 (QR escaneado en kiosk)
  entryTime DateTime? // Hora exacta de entrada Tramo 1
  exitTime  DateTime? // Hora exacta de salida Tramo 1 (o salida final en turno continuo)

  // Marcaciones físicas Tramo 2 (para horario partido / doble turno)
  entryTime2 DateTime? // Hora exacta de entrada Tramo 2 (retorno de receso/almuerzo)
  exitTime2  DateTime? // Hora exacta de salida Tramo 2 (fin de jornada)

  // Metodo de marcación
  entryMethod PunchMethod?
  exitMethod  PunchMethod?

  // Estado calculado
  status        AttendanceStatus @default(PENDIENTE)
  wrongLocation Boolean          @default(false)

  // Excepciones y aprobaciones
  requiresManagerApproval Boolean @default(false)
  approvalReason          String? // Ej: "Olvido de fotocheck", "Falla de Kiosko"

  // Métricas calculadas al cierre del día
  workedMinutes Int?
  lateMinutes   Int? // Minutos de retraso respecto al horario Tramo 1
  lateMinutes2  Int? // Minutos de retraso respecto al horario Tramo 2

  // Auditoría de cambios de estado
  notes           String?
  statusChangedAt DateTime?
  statusChangedBy String? // UUID del admin o literal "SISTEMA" / "CRON_EOD"

  // Modo Ultra-Offline (Kiosk)
  isOfflineSync Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un solo registro por usuario por día
  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@index([userId])
  @@map("attendances")
}

enum AttendanceStatus {
  PENDIENTE // Aún no termina el día laboral
  PRESENTE // Entró y salió correctamente
  TARDE // Llegó después del tiempo de tolerancia
  AUSENTE // No marcó entrada (fin de jornada)
  ABANDONO_PUESTO // Marcado manualmente o por excepción
  INCOMPLETO // Marcó entrada pero no salida al cierre del día
  JUSTIFICADO // Falta con justificación aprobada por admin
  FERIADO // Día no laborable
  PERMISO // Permiso aprobado previamente
  DIA_LIBRE // Día de descanso (rotativo o fijo)
  VACACIONES // Vacaciones aprobadas
  DESCANSO_MEDICO // Licencia o incapacidad médica
}

// ─────────────────────────────────────────────────────────────
//  SOLICITUDES DE AUSENCIA / VACACIONES
// ─────────────────────────────────────────────────────────────

model TimeOffRequest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  type           TimeOffType
  status         RequestStatus @default(PENDING)
  
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  
  reason         String?
  documentUrl    String?       // URL a S3/R2 para el certificado médico
  
  reviewedBy     String?       @db.Uuid // ID del Admin que aprobó/rechazó
  reviewedAt     DateTime?
  rejectionReason String?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@map("time_off_requests")
}

enum TimeOffType {
  VACACIONES
  DESCANSO_MEDICO
  PERMISO_PERSONAL
  MATERNIDAD_PATERNIDAD
  LUTO
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
//  NOTIFICACIONES
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json? // Metadata extra (attendanceId, locationId, etc.)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ABANDONO_REGISTRADO
  LLEGADA_TARDE
  RECORDATORIO_SALIDA
  FALTA_REGISTRADA
  BIENVENIDA
  CAMBIO_SEDE_HORARIO
}

// ─────────────────────────────────────────────────────────────
//  SUSCRIPCIONES PUSH (Web Push API / VAPID)
// ─────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────────────────────
//  LOGS DE AUDITORÍA (Trazabilidad y Seguridad)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?       @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     AuditAction
  entityType String // ATTENDANCE | USER | LOCATION | KIOSK | SCHEDULE | SYSTEM
  entityId   String?

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum AuditAction {
  ATTENDANCE_SCANNED
  ATTENDANCE_STATUS_CHANGED
  ATTENDANCE_JUSTIFIED
  ATTENDANCE_EDITED_MANUAL
  QR_GENERATED
  QR_REGENERATED
  QR_INVALIDATED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  JOB_EXECUTED
  TIME_OFF_REQUESTED
  TIME_OFF_APPROVED
  TIME_OFF_REJECTED
}
